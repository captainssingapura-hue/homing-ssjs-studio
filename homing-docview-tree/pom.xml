<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-docview-tree</artifactId>

    <description>
        The first stage of viewing a doc, headless and pure: a markdown, rigid or composed
        doc made into a tree of named headings, each with at most one leaf - its own content,
        a list of parts: prose, code, tables, images - the names by the naming rules; the tree
        as a tree placement of widgets, each with its params; and the content of every part,
        by its key, as the payload a page loads. Knows no page, no widget and no site.
    </description>

    <dependencies>
        <!-- The docs, as data. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-doc-model</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The placement the tree becomes: TreePlacement, Arrangement. Pure, no widget. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-groups-core-models</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- What it is validated against: the reference docs, one of each kind. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-reference</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The payload read as a page reads it: JSON.parse, headless. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
