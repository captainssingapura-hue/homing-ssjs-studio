<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-planview-app</artifactId>

    <description>
        PlanView, the app: the page every plan is read on - DocView's desk, the contents beside
        the plan, its pillars and its phases its sections, every part a widget asking its content
        party; a phase's details folded in its widget until they are asked for. A plan placed in a
        catalogue, its page holding it, read at its authentic path. No plan registry, no id.
    </description>

    <dependencies>
        <!-- The desk a plan is read on, as a doc is. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- A plan's widgets. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-planview-widgets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The page that holds a plan, as the payload route reads it. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-site</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-gate</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-reference</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
