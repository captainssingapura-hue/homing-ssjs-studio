<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The studio sub-domain of homing.js, rebuilt on the site stack: catalogues
         organise otherwise independent pages, trees compose by grafting, and every
         page is reached by its authentic path - its position in the composed tree.

         The MODEL is core's (homing-site-catalogue): the catalogue, the graft, the
         tree and its router, knowing no app. This repo is the implementation around
         it - the listing a site shows at each catalogue, wearing the site's chrome,
         and the route it reads from - and, later, the applications: technical
         writing (docs) and planning (plans), each an app that contributes pages.

         Nothing here depends on the studio's old stack (homing-studio-base and
         what it brings); a gate says so. -->
    <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
    <artifactId>homing.js.studio</artifactId>
    <version>LOCAL-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <!-- The gate every module's tests hold it to. -->
        <module>homing-catalogue-gate</module>
        <!-- The catalogue as widgets, each independent, meeting in a catalogue party: the tree, the details,
             the cards, and the browser - the tree and the details composed. Knows no app. -->
        <module>homing-catalogue-widgets</module>
        <!-- The catalogue as a site serves it: the route the widgets read an entry from, and the listing at
             each catalogue - a page of the site's MPA hosting the browser. Knows no app. -->
        <module>homing-catalogue-site</module>
        <!-- The demo: two hypothetical apps, each a module of its own that knows no site - notes and
             recipes, their pages and their trees - and a site that grafts both, on 8106. -->
        <module>homing-catalogue-demo-notes</module>
        <module>homing-catalogue-demo-recipes</module>
        <module>homing-catalogue-demo</module>
        <!-- DocView, the first stage: a doc made into a tree of headings, each with its leaf of parts;
             the tree as a placement of widgets; the content of every part. Pure, headless. -->
        <module>homing-docview-tree</module>
        <!-- The reference docs: one of each kind the view takes, crafted to hold every construct. Docs as data. -->
        <module>homing-docview-reference</module>
        <!-- DocView on a site: a doc placed in a catalogue, its page holding it; the routes by its authentic path; the inspector. -->
        <module>homing-docview-site</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The substrate, from the core repo. Its own version, not ours. -->
        <homing.core.version>LOCAL-SNAPSHOT</homing.core.version>
        <!-- The ui-components (and the MPA's standard implementation), from homing-ssjs-ui-components. -->
        <homing.components.version>LOCAL-SNAPSHOT</homing.components.version>
        <!-- The workspace: the widget contract and the typed parties widgets meet in (homing-ssjs-workspace). -->
        <homing.ws.version>LOCAL-SNAPSHOT</homing.ws.version>
        <!-- The relation grid family (a repo of its own): the tree. -->
        <homing.relgrid.version>LOCAL-SNAPSHOT</homing.relgrid.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
