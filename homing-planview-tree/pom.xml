<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-planview-tree</artifactId>

    <description>
        A plan made into a tree, headless and pure, as a doc is: the plan its root, its head
        the root's leaf; a section for each pillar it fills - objectives, decisions, acceptance -
        and a section for each phase, named by its id. The tree is written as the same payload
        a doc's is, so a page lays a plan out on the same tree placement, its parts asked for
        through the same content parties. Knows no page, no widget and no site.
    </description>

    <dependencies>
        <!-- The plans, as data. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-plan-model</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The doc's tree: the names, the JSON the payload is written in, a resolved doc reference. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-tree</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- What it is validated against: the reference plan. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-reference</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The payload read as a page reads it: JSON.parse, headless. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
