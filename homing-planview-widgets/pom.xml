<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-planview-widgets</artifactId>

    <description>
        A plan's widgets, each working alone by its params as a doc's primitives do: its head -
        progress, counts, the docs it names; its lists - objectives, decisions, acceptance; and
        its phases, each where it stands, its details folded until they are asked for. Their
        content types and stewards read the plan's payload as a doc's parts are read.
    </description>

    <dependencies>
        <!-- A doc's primitives: the base a widget is, the steward of a payload's parts, markdown made into elements, the sheet. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-widgets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The content parties: their params, their secretary, the pattern their types follow. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-content</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <!-- What a widget is. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-widgets</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core-js</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-component-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-design-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-gate</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
