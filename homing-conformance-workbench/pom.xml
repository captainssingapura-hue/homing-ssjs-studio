<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-conformance-workbench</artifactId>

    <description>
        The conformance studio on the new stack: the conformance workbench - the crates
        and their modules, the dependency graph, a node's summary and source, crate and
        module conformance, the exported report - and the components workbench, as
        widgets on the grouped workspace page; the feeds they read, computed from the
        crates a studio is given and the report its build exported; and the studio put
        together from them (ConformanceStudio), for a launcher to serve.
    </description>

    <dependencies>
        <!-- The workspace: the widget contract, the parties, the grouped page, the arrangements. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-widgets</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-parties</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-site</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-groups-core-models</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <!-- The navigators' tree, and the row a catalogue tree draws. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-tree</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid-protocol</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>homing-catalogue-widgets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The graph: DocView's mermaid engine and SVG reader, and the pan-zoom view. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>homing-docview-widgets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-panzoom</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <!-- What the feeds read: the crates, their conformance, the exported report and its codecs, the components. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-export</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-report-codec</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-report-gen</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-codec-ecma</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-component-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-rigid-tree</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The studio put together: the page and the MPA it is served through, the designs, the server. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-server</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>homing-catalogue-gate</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-engine</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
