<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
        <artifactId>homing.js.studio</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-catalogue-demo</artifactId>

    <description>
        The catalogue, demonstrated: a site whose root grafts two apps' trees - notes, and
        recipes shown as the kitchen - and places a note of its own; every page, and every
        catalogue's listing, a page of the site's one MPA, reached at its authentic path.
        Run with DemoServer; listens on 8106.
    </description>

    <dependencies>
        <!-- The tree's and the document widgets' components, registered with the house's styling (RFC 0067, D17). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-tree</artifactId>
            <version>${homing.ws.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-widgets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-site</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-demo-notes</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-demo-recipes</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- DocView on the site: the app, its routes and the inspector; and the reference docs it places. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- PlanView: the reference plans, read on the same desk. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-planview-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-site</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-reference</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The site's one MPA: the standard implementation, and the designs it offers. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <!-- The house's styles ready-made: the styling the site's MPA installs (The Style Jars). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-styles</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <!-- The grid's frame, registered with the house's styling (D51). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid-house</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-gate</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn -o -pl homing-catalogue-demo exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>hue.captains.singapura.js.homing.catalogue.demo.DemoServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
